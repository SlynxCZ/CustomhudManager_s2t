import os, sys, json, importlib.util

def ResolveEnvPath(env, folder):
  if env in os.environ:
    path = os.environ[env]
    if os.path.isdir(path):
      return path
  else:
    head = os.getcwd()
    oldhead = None
    while head != None and head != oldhead:
      path = os.path.join(head, folder)
      if os.path.isdir(path):
        return path
      oldhead = head
      head, tail = os.path.split(head)
  return None

def ResolveToolkitSdk():
  path = os.environ.get('SOURCE2TOOLKIT_SDK')
  if not path or not os.path.isdir(path):
    raise Exception('SOURCE2TOOLKIT_SDK is not set to a valid directory')
  return os.path.abspath(os.path.normpath(path))

toolkit_sdk_root = ResolveToolkitSdk()

# The SDK's own build helper, pulled in by absolute path: it lives outside
# this plugin's source tree.
ToolkitSdk = builder.Eval(os.path.join(toolkit_sdk_root, 'SdkPlugin.ambuild'), {})

# s2sdk-manifests' SdkHelpers: what a binary needs from s2sdk (include paths,
# defines, libraries with the Steam API, protoc), the same lists s2sdk::s2sdk
# has in CMake. A toolkit plugin never includes a metamod header, so there is
# no MMSOURCE_DEV here. The manifests come from the SDK's own submodule unless
# --s2sdk-manifests or S2SDK_MANIFESTS_DIR points elsewhere.
SdkHelpers = ToolkitSdk.LoadSdkHelpers(builder, builder.options.s2sdk_manifests)

# The build settings, split the same way as the CMake side (makefiles/cmake/):
# shared.ambuild <-> shared.cmake, linux.ambuild <-> linux.cmake,
# windows.ambuild <-> windows.cmake. A toolkit plugin has no metamod .vdf.
Shared = builder.Import('makefiles/ambuild/shared.ambuild')
Linux = builder.Import('makefiles/ambuild/linux.ambuild')
Windows = builder.Import('makefiles/ambuild/windows.ambuild')


class MMSPluginConfig(object):
  def __init__(self):
    self.sdk_manifests = []
    self.sdks = {}
    self.sdk_targets = []
    self.binaries = []
    self.all_targets = []
    self.target_archs = set()

    if builder.options.plugin_name is not None:
      self.plugin_name = builder.options.plugin_name
    else:
      self.plugin_name = 'customhud_manager'

    if builder.options.plugin_alias is not None:
      self.plugin_alias = builder.options.plugin_alias
    else:
      self.plugin_alias = 'customhud'

    if builder.options.targets:
      target_archs = builder.options.targets.split(',')
    else:
      target_archs = ['x86', 'x86_64']

    for arch in target_archs:
        try:
            cxx = builder.DetectCxx(target_arch = arch)
            self.target_archs.add(cxx.target.arch)
        except Exception as e:
            # Error if archs were manually overridden.
            if builder.options.targets:
                raise
            print('Skipping target {}: {}'.format(arch, e))
            continue
        self.all_targets.append(cxx)

    if not self.all_targets:
        raise Exception('No suitable C/C++ compiler was found.')

  def findSdkPath(self, sdk_name):
    dir_name = 'hl2sdk-{}'.format(sdk_name)
    if builder.options.hl2sdk_root:
      sdk_path = os.path.join(builder.options.hl2sdk_root, dir_name)
      if os.path.exists(sdk_path):
        return sdk_path
    # The manifest's environment variables (cs2: S2SDK_CS2, S2SDKCS2, S2SDK,
    # HL2SDK_CS2, HL2SDKCS2 -- first set wins), else the Source2Toolkit SDK's
    # own vendor/s2sdk submodule.
    sdk_path = ToolkitSdk.FindS2Sdk(sdk_name)
    if sdk_path:
      return sdk_path
    return ResolveEnvPath('HL2SDK{}'.format(sdk_name.upper()), dir_name)

  def detectSDKs(self):
    sdk_list = [s for s in builder.options.sdks.split(',') if s]
    SdkHelpers.find_sdk_path = self.findSdkPath
    SdkHelpers.findSdks(builder, self.all_targets, sdk_list)

    self.sdks = SdkHelpers.sdks
    self.sdk_manifests = SdkHelpers.sdk_manifests
    self.sdk_targets = SdkHelpers.sdk_targets

    if len(self.sdks) > 1:
      raise Exception('Only one sdk at a time is supported, for multi-sdk approach use loader based solution.')

  def configure(self):
    for cxx in self.all_targets:
      if cxx.target.arch not in ['x86', 'x86_64']:
        raise Exception('Unknown target architecture: {0}'.format(arch))

      self.configure_cxx(cxx)

  def configure_cxx(self, cxx):
    # makefiles/ambuild/shared.ambuild, then linux.ambuild or windows.ambuild --
    # the AMBuild twins of makefiles/cmake/shared.cmake, linux.cmake, windows.cmake.
    Shared.ConfigureCxx(cxx, builder.options)
    self.Platform(cxx).ConfigureCxx(cxx, builder.options)

  def Platform(self, cxx):
    if cxx.target.platform == 'linux':
      return Linux
    if cxx.target.platform == 'windows':
      return Windows
    raise Exception('Unsupported target platform: {0}'.format(cxx.target.platform))

  def Library(self, cxx, name):
    binary = cxx.Library(name)
    return binary
  
  def ToolkitLibrary(self, context, compiler, name, sdk):
    binary = self.Library(compiler, name)
    Shared.ConfigureBinary(context, binary, sdk, self)

    # Includes, defines and the SDK's own sources -- including the s2sdk
    # translation units it owns, which is why none are listed here. Its extra
    # s2sdk include paths go ahead of s2sdk-manifests' ones, as in CMake.
    ToolkitSdk.AddToBinary(binary, sdk)

    # s2sdk's include paths, defines and libraries (the Steam API among them).
    SdkHelpers.configureCxx(context, binary, sdk)

    self.Platform(binary.compiler).ConfigureBinary(context, binary, sdk, self)
    return binary

MMSPlugin = MMSPluginConfig()
MMSPlugin.detectSDKs()
MMSPlugin.configure()

BuildScripts = [
  'makefiles/ambuild/AMBuilder',
  'makefiles/ambuild/package.ambuild'
]

builder.Build(BuildScripts, { 'MMSPlugin': MMSPlugin, 'ToolkitSdk': ToolkitSdk })
